{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "files": {
    // SCSS is handled by stylelint; biome's property sorting reorders $variables below their usage
    "includes": ["./src/**/*", "./scripts/**/*", "!**/*.scss"]
  },
  "javascript": {
    "globals": ["Bun", "activeDocument"]
  },
  "linter": {
    "rules": {
      "complexity": {
        "noForEach": "off",
        "noExcessiveCognitiveComplexity": "warn"
      },
      "style": {
        "useDestructuring": "off",
        "useThisInClassMethods": "off",
        "noIncrementDecrement": "off"
      },
      "suspicious": {
        "noUnnecessaryConditions": "off"
      }
    }
  }
}
